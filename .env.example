# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Public links used by buttons (leave empty until known)
NEXT_PUBLIC_SITE_URL=https://luma.itechintl.com
NEXT_PUBLIC_APP_SIGNIN_URL=
NEXT_PUBLIC_APP_SIGNUP_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets for the demo form (/api/lead)
TURNSTILE_SECRET_KEY=

# Demo requests are emailed to sales via Resend's HTTP API.
# LEAD_EMAIL_FROM must use a domain verified in Resend; LEAD_EMAIL_TO accepts several addresses, comma-separated.
RESEND_API_KEY=
LEAD_EMAIL_FROM=LUMA Website <no-reply@luma.itechintl.com>
LEAD_EMAIL_TO=sales@itechintl.com
