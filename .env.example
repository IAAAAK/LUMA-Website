# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Public links used by buttons (leave empty until known)
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_APP_SIGNIN_URL=
NEXT_PUBLIC_APP_SIGNUP_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets for the demo form (/api/lead)
TURNSTILE_SECRET_KEY=
ODOO_URL=https://your-company.odoo.com
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_SALES_TEAM_ID=
ODOO_SOURCE_NAME=Website – LUMA

# Fallback email when Odoo is unreachable (sent via Resend's HTTP API)
RESEND_API_KEY=
LEAD_FALLBACK_FROM=LUMA website <no-reply@example.com>
LEAD_FALLBACK_TO=sales@example.com
